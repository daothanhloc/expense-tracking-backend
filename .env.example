# Server
PORT=3000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/couple-finance

# Zalo
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET_KEY=your_zalo_app_secret_key

# LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
LLM_MODEL=claude-haiku-4-20250514

# JWT
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=30d

# Allowed Zalo User IDs (comma-separated)
USER_LOC_ZALO_ID=
USER_DUONG_ZALO_ID=

# Allowed Phone Numbers (for phone+password auth)
USER_LOC_PHONE=
USER_DUONG_PHONE=
